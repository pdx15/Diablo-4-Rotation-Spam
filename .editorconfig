# EditorConfig: https://editorconfig.org
# Fixing the include order for Win32 SDK headers:
# shellapi.h / shldisp.h / shlobj.h must be parsed AFTER windows.h,
# so includes must NOT be auto-sorted alphabetically.
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{c,cpp,h,hpp,rc}]
cpp_sort_includes_error_tag_type = none
cpp_include_cleanup_sort_after_edits = false
